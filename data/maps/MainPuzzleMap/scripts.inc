MainPuzzleMap_MapScripts::
	map_script MAP_SCRIPT_ON_RETURN_TO_FIELD, MainPuzzleMap_MapScript_OnReturnToField
	.byte 0

MainPuzzleMap_MapScript_OnReturnToField::
	callnative LoadCurrentMapData
	special DrawWholeMapView
	end

MainPuzzleMap_TrainerBattle::
	trainerbattle_single TRAINER_EDGAR, VictoryRoad_1F_Text_EdgarIntro, VictoryRoad_1F_Text_EdgarDefeat, MainPuzzleMap_TrainerBattleAfter
MainPuzzleMap_TrainerBattleAfter::
	cleartrainerflag TRAINER_EDGAR
	releaseall
	end

